# Careful Unified Optimizer v6.4 Micro-Lag Eliminator
# Surgical Stutter Fix for MTK Dimensity 7050 (MT6877) on Android 15

# ===== ZERO-LATENCY INTERFACE =====
# Force instant CPU ramp up
persist.sys.sugov.up_rate_limit_us=0
persist.sys.sugov.down_rate_limit_us=50000

# Force instant GPU ramp up (MediaTek GED)
persist.vendor.mtk.ged.boost_enable=1
persist.vendor.mtk.ged.smart_boost=1

# ===== REELS & FB/INSTA STUTTER FIX =====
# Aggressive media priority
persist.sys.media.priority=1
debug.sf.latch_unsignaled=1
debug.sf.disable_backpressure=1
ro.surface_flinger.max_frame_buffer_acquired_buffers=4

# Force 120Hz system-wide
persist.sys.peak_refresh_rate=120.0
persist.sys.min_refresh_rate=120.0

# ===== I/O LATENCY REDUCTION =====
# Optimize for small database reads (Reels loading)
persist.sys.io.latency=1
persist.sys.io.no_merges=2

# ===== ANDROID 15 FREEZER & RAM =====
cached_apps_freezer=enabled
persist.sys.cached_apps_freezer=enabled
persist.sys.smart_ram_management=1
ro.config.fha_enabled=true

# ===== LOG OPTIMIZATIONS =====
persist.logd.logpersistd=0
persist.sys.boot.logcat=0
logd.log_size=64K
persist.logd.size=64K
