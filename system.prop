# Careful Unified Optimizer v6.3 Ultimate Smoothness
# Total Smoothness MTK Dimensity 7050 (MT6877) optimization for Android 15

# ===== REELS & VIDEO SMOOTHNESS =====
# Prioritize media codecs and surfaceflinger for zero-stutter
persist.sys.media.priority=1
debug.sf.latch_unsignaled=1
debug.sf.disable_backpressure=1
ro.surface_flinger.max_frame_buffer_acquired_buffers=3

# Force HEVC hardware decoder priority
debug.stagefright.omx_default_rank=0
media.stagefright.thumbnail.prefer_hw_codecs=1
persist.sys.media.use_hw_codecs=1

# ===== DISPLAY PERFORMANCE =====
# Unlock and force 120Hz for scrolling smoothness
persist.sys.peak_refresh_rate=120.0
persist.sys.min_refresh_rate=120.0
ro.surface_flinger.use_content_detection_for_refresh_rate=1

# ===== GAMING & SCHEDULER =====
sys.use_fifo_ui=1
persist.sys.use_fifo_ui=1
persist.vendor.mtk.perf_turbo=1
persist.vendor.mtk.fpsgo.enable=1
persist.vendor.mtk.game_mode=1

# ===== ANDROID 15 FREEZER & RAM =====
cached_apps_freezer=enabled
persist.sys.cached_apps_freezer=enabled
persist.sys.smart_ram_management=1
ro.config.fha_enabled=true

# ===== NETWORK OPTIMIZATIONS =====
net.ipv4.tcp_congestion_control=bbr
net.ipv4.tcp_fastopen=3

# ===== LOG OPTIMIZATIONS =====
persist.logd.logpersistd=0
persist.sys.boot.logcat=0
logd.log_size=64K
persist.logd.size=64K
